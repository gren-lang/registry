module Route.PublishingIdentity exposing
    ( create
    )


import Bytes exposing (Bytes)
import Sqlite
import Json.Decode
import Json.Encode
import Log
import PublishingIdentity exposing (PublishingIdentity)
import Route exposing (Response)
import Route.Error
import Task exposing (Task)
import User exposing (User)


type Error
    = DbError Sqlite.Error


-- ENDPOINTS


{-| POST to register a new publishing identity.

The authenticated `user` becomes the first member of the new identity.
-}
create :
    { db : Sqlite.Database
    , user : User
    , body : Bytes
    , response : Response
    }
    -> Task Never Response
create { db, user, body, response } =
    when getName body is
        Nothing ->
            Route.Error.invalidRequestData response
                "Request json must contain a non-empty `name` field."

        Just name ->
            createIdentity db name user
                |> Task.map (createSuccess response)
                |> Task.onError (createFailed response)


-- REQUEST PARSING


getName : Bytes -> Maybe String
getName bytes =
    bytes
        |> Bytes.toString
        |> Maybe.andThen decodeName
        |> Maybe.map String.trim
        |> Maybe.andThen
            (\name ->
                if String.isEmpty name then
                    Nothing

                else
                    Just name
            )


decodeName : String -> Maybe String
decodeName json =
    json
        |> Json.Decode.decodeString (Json.Decode.field "name" Json.Decode.string)
        |> Result.toMaybe


-- ACTIONS


createIdentity : Sqlite.Database -> String -> User -> Task Error PublishingIdentity
createIdentity db name user =
    PublishingIdentity.create db { user = user, name = name }
        |> Task.mapError DbError


-- RESPONSES


createSuccess : Response -> PublishingIdentity -> Response
createSuccess response identity =
    let
        responseJson =
            Json.Encode.object
                [ { key = "id", value = Json.Encode.int identity.id }
                , { key = "name", value = Json.Encode.string identity.name }
                ]
    in
    response
        |> Route.setHeader "Content-Type" "application/json"
        |> Route.setBody (Json.Encode.encode 0 responseJson)


createFailed : Response -> Error -> Task x Response
createFailed response error =
    when error is
        DbError (Sqlite.UniqueConstraintError _) ->
            response
                |> Route.setStatus 409
                |> setErrorMessage "That publishing identity name is already taken."
                |> Task.succeed

        DbError e ->
            let
                errorMsg =
                    "Database error creating publishing identity: " ++
                    Sqlite.errorToString e
            in
            response
                |> Route.log (Log.Error errorMsg)
                |> Route.setStatus 500
                |> setErrorMessage "Database error"
                |> Task.succeed


-- HELPERS


setErrorMessage : String -> Response -> Response
setErrorMessage message response =
    let
        body =
            Json.Encode.object
                [ { key = "message", value = Json.Encode.string message } ]
    in
    response
        |> Route.setHeader "Content-Type" "application/json"
        |> Route.setBody (Json.Encode.encode 0 body)
