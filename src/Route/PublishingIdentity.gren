module Route.PublishingIdentity exposing
    ( create
    )


import Bytes exposing (Bytes)
import Sqlite
import Json.Decode
import Json.Encode
import Log
import PublishingIdentity exposing (PublishingIdentity)
import Route exposing (Response)
import Route.Error
import Task exposing (Task)
import User exposing (User)


type Error
    = InvalidSession
    | DbError Sqlite.Error


-- ENDPOINTS


{-| POST to register a new publishing identity.

Requires a valid session token. The authenticated user becomes the first
member of the new identity.
-}
create :
    { db : Sqlite.Database
    , body : Bytes
    , response : Response
    }
    -> Task Never Response
create { db, body, response } =
    when getCreateRequest body is
        Nothing ->
            Route.Error.invalidRequestData response
                "Request json must contain a non-empty `session` and `name` field."

        Just { sessionToken, name } ->
            findUser db sessionToken
                |> Task.andThen (createIdentity db name)
                |> Task.map (createSuccess response)
                |> Task.onError (createFailed response)


-- REQUEST PARSING


type alias CreateRequest =
    { sessionToken : String
    , name : String
    }


getCreateRequest : Bytes -> Maybe CreateRequest
getCreateRequest bytes =
    bytes
        |> Bytes.toString
        |> Maybe.andThen decodeCreateRequest
        |> Maybe.andThen validateCreateRequest


decodeCreateRequest : String -> Maybe CreateRequest
decodeCreateRequest json =
    json
        |> Json.Decode.decodeString createRequestDecoder
        |> Result.toMaybe


createRequestDecoder : Json.Decode.Decoder CreateRequest
createRequestDecoder =
    Json.Decode.map2
        (\token name -> { sessionToken = token, name = name })
        (Json.Decode.field "session" Json.Decode.string)
        (Json.Decode.field "name" Json.Decode.string)


validateCreateRequest : CreateRequest -> Maybe CreateRequest
validateCreateRequest request =
    if String.isEmpty request.sessionToken || String.isEmpty request.name then
        Nothing
    else
        Just request


-- ACTIONS


findUser : Sqlite.Database -> String -> Task Error User
findUser db sessionToken =
    User.findBySessionToken db sessionToken
        |> Task.mapError
            (\error ->
                when error is
                    Sqlite.NoResultsError ->
                        InvalidSession

                    _ ->
                        DbError error
            )


createIdentity : Sqlite.Database -> String -> User -> Task Error PublishingIdentity
createIdentity db name user =
    PublishingIdentity.create db { user = user, name = name }
        |> Task.mapError DbError


-- RESPONSES


createSuccess : Response -> PublishingIdentity -> Response
createSuccess response identity =
    let
        responseJson =
            Json.Encode.object
                [ { key = "id", value = Json.Encode.int identity.id }
                , { key = "name", value = Json.Encode.string identity.name }
                ]
    in
    response
        |> Route.setHeader "Content-Type" "application/json"
        |> Route.setBody (Json.Encode.encode 0 responseJson)


createFailed : Response -> Error -> Task x Response
createFailed response error =
    when error is
        InvalidSession ->
            response
                |> Route.setStatus 400
                |> setErrorMessage "Invalid session token."
                |> Task.succeed

        DbError (Sqlite.UniqueConstraintError _) ->
            response
                |> Route.setStatus 409
                |> setErrorMessage "That publishing identity name is already taken."
                |> Task.succeed

        DbError e ->
            let
                errorMsg =
                    "Database error creating publishing identity: " ++
                    Sqlite.errorToString e
            in
            response
                |> Route.log (Log.Error errorMsg)
                |> Route.setStatus 500
                |> setErrorMessage "Database error"
                |> Task.succeed


-- HELPERS


setErrorMessage : String -> Response -> Response
setErrorMessage message response =
    let
        body =
            Json.Encode.object
                [ { key = "message", value = Json.Encode.string message } ]
    in
    response
        |> Route.setHeader "Content-Type" "application/json"
        |> Route.setBody (Json.Encode.encode 0 body)
